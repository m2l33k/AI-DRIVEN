<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.javatab.microservices</groupId>
    <artifactId>auth-management-system</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>auth-management-system</name>
    <description>Parent Pom for the auth management platform</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <build>
        <plugins>
            <!-- Runs *IT.java classes during `mvn verify` (after unit tests) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- OWASP Dependency-Check: scans all module JARs against NVD CVE database -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>12.1.1</version>
                <configuration>
                    <!-- NVD API key speeds up the DB download from hours to minutes.
                         Set as Jenkins secret: nvd-api-key -->
                    <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                    <format>ALL</format>
                    <!-- fail build only on CRITICAL (CVSS >= 9); reports are still
                         generated for HIGH so Jenkins can display them -->
                    <failBuildOnCVSS>9</failBuildOnCVSS>
                    <failOnError>false</failOnError>
                    <suppressionFiles>
                        <suppressionFile>owasp-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <outputDirectory>${project.build.directory}/dependency-check</outputDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <modules>
        <module>util</module>
        <module>spring-cloud/eureka-server</module>
        <module>spring-cloud/gateway-service</module>
        <module>microservices/auth-service</module>
        <module>microservices/roaming-analysis-service</module>
        <module>microservices/anomaly-detection-service</module>
        <module>microservices/rate-limiting-service</module>
        <module>microservices/distributed-tracing-service</module>
        <module>microservices/fault-injection-service</module>
        <module>microservices/messaging-service</module>
        <module>microservices/fivegc-service</module>
        <module>microservices/audit-service</module>
    </modules>
</project>
