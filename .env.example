# Copy this file to ".env" (same directory) and fill in real values.
# ".env" is gitignored, so your secrets never get committed.
#
# run.sh loads ".env" automatically for both local and docker modes.

# --- Gmail SMTP for password-reset OTP emails (auth-service) ------------------
# MAIL_USERNAME: the Gmail address that sends the emails.
# MAIL_PASSWORD: a Google "App Password" (NOT your normal Gmail password).
#   Create one at: Google Account -> Security -> 2-Step Verification -> App passwords.
#   Paste the 16 characters with the spaces removed.
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your16charapppassword
