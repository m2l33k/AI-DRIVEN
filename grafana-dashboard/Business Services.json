      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [{ "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "1000 * max by (job) (http_server_requests_seconds_max{job=~\"$service\"})", "legendFormat": "{{job}}" }],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 14, "type": "table", "title": "Slowest endpoints (avg ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
