meta {
  name: AccessToken
  type: http
  seq: 1
}

post {
  url: {{keycloakBaseUrl}}/realms/auth-management/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: platform-client
  client_secret: platform-client-secret
  username: operator-user
  password: password
  scope: openid roles
}
