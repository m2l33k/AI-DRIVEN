    <!-- ================================================================
         A. JACKSON 2.20.2 (com.fasterxml.jackson) — BOM-managed
         Fixed in Jackson 2.20.3+ / Spring Boot 4.0.6+
         ================================================================ -->
    <suppress>
        <notes>BOM-managed: Jackson 2.20.2 (com.fasterxml.jackson.*) locked by Spring Boot 4.0.3. Fixed in 2.20.3+/SB 4.0.6+.</notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\..*/.*@2\.20\.2$</packageUrl>
    </suppress>
    <suppress>
        <notes>BOM-managed: jackson-annotations 2.20 locked by Spring Boot 4.0.3. Fixed in 2.20.3+.</notes>
