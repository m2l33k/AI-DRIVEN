        <packageUrl regex="true">^pkg:maven/org\.postgresql/postgresql@42\.7\.10$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>

    <!-- ── B. FALSE POSITIVE: mxparser misidentified as XStream ──
         mxparser (io.github.x-stream/mxparser) is a standalone XML pull-parser.
         OWASP DC CPE heuristics map it to cpe:2.3:a:xstream_project:xstream,
         reporting all XStream RCE/DoS CVEs against it. mxparser has no known CVEs. -->
    <suppress>
        <notes>FALSE POSITIVE: mxparser is a pull-parser, not XStream. OWASP DC CPE misidentification.</notes>
        <packageUrl regex="true">^pkg:maven/io\.github\.x-stream/mxparser@.*$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>

    <!-- ── B. FALSE POSITIVE: swagger-ui bundled DOMPurify JS ──
         swagger-ui webjar bundles DOMPurify 3.3.2. RetireJS scanner flags it.
         The Swagger UI endpoint is protected by Keycloak; untrusted user HTML
         is not accepted, making XSS via DOMPurify bypass non-exploitable. -->
    <suppress>
        <notes>FALSE POSITIVE / LOW-RISK: DOMPurify inside swagger-ui webjar. Endpoint is Keycloak-protected.</notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>

</suppressions>
