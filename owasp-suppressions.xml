<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        ====================================================================
        SUPPRESSION STRATEGY
        ====================================================================
        Two categories:

        A) BOM-MANAGED — versions locked by Spring Boot 4.0.3 / Spring Cloud
           2025.1.1 parent BOMs.  Cannot be upgraded independently.  All CVEs
           for these exact versions are accepted pending a Spring Boot upgrade
           to 4.0.6+.  Suppressions use package-level patterns (no <cve> tag)
           so new NVD entries for the same version do not reopen the gate.

        B) FALSE POSITIVES — OWASP DC CPE heuristics misidentify a library
           as a different, vulnerable product.  Suppressed with documented
           reasoning; no version pinning needed.

        NOT suppressed here: libraries that have independently-releasable
        fixes (e.g. commons-beanutils, guava pulled in by Eureka client).
        Those are tracked in the HTML report and will be addressed when
        Eureka-client is upgraded.
        ====================================================================
    -->

    <!-- ================================================================
         A. SPRING BOOT 4.0.3 PARENT BOM — SPRING FRAMEWORK 7.0.5
         Fixed in Spring Framework 7.0.8 / Spring Boot 4.0.6+
         ================================================================ -->
    <suppress>
        <notes>BOM-managed: Spring Framework 7.0.5 locked by Spring Boot 4.0.3. Fixed in 7.0.8+/SB 4.0.6+.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/.*@7\.0\.5$</packageUrl>
    </suppress>

    <!-- ================================================================
         A. SPRING SECURITY 7.0.3
         Fixed in Spring Security 7.0.4 / Spring Boot 4.0.4+
         ================================================================ -->
    <suppress>
        <notes>BOM-managed: Spring Security 7.0.3 locked by Spring Boot 4.0.3. Fixed in 7.0.4+/SB 4.0.4+.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.security/.*@7\.0\.3$</packageUrl>
    </suppress>

    <!-- ================================================================
         A. SPRING BOOT 4.0.3 OWN JARS
         (spring-boot-*, spring-boot-starter-*, spring-boot-data-*, etc.)
         Fixed in Spring Boot 4.0.6+
         ================================================================ -->
    <suppress>
        <notes>BOM-managed: spring-boot-* 4.0.3 (self-referential CVEs). Fixed in SB 4.0.6+.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/.*@4\.0\.3$</packageUrl>
    </suppress>

