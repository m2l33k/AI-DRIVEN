    <!-- ================================================================
         A. JACKSON 3.0.4 (tools.jackson.core) — Spring Boot 4 internal
         Spring Boot 4.x introduced Jackson 3 modules for internal use.
         Fixed when Spring Boot upgrades its internal Jackson 3 dependency.
         ================================================================ -->
    <suppress>
        <notes>BOM-managed: Jackson 3.0.4 (tools.jackson.core.*) bundled internally by Spring Boot 4.0.3. Fixed with SB 4.0.6+.</notes>
        <packageUrl regex="true">^pkg:maven/tools\.jackson\.core/.*@3\.0\.4$</packageUrl>
    </suppress>

    <!-- ================================================================
         A. LOG4J-API 2.25.3 — BOM-managed
         log4j-api at 2.25.x has NVD entries that are false positives for
         the API-only artifact (no appenders, no JndiLookup class).
         Risk: log4j-api is used as a logging bridge only; actual logging
         goes through Logback. Fixed in log4j-api 2.25.4+/SB 4.0.6+.
         ================================================================ -->
    <suppress>
        <notes>BOM-managed: log4j-api 2.25.3 used as bridge only (no appenders). Fixed in 2.25.4+/SB 4.0.6+.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/.*@2\.25\.3$</packageUrl>
    </suppress>

    <!-- ================================================================
         A. POSTGRESQL JDBC 42.7.10 — BOM-managed
         Fixed in postgresql 42.7.11+ / Spring Boot 4.0.6+
         ================================================================ -->
    <suppress>
        <notes>BOM-managed: PostgreSQL JDBC 42.7.10 locked by Spring Boot 4.0.3. Fixed in 42.7.11+/SB 4.0.6+.</notes>
        <packageUrl regex="true">^pkg:maven/org\.postgresql/postgresql@42\.7\.10$</packageUrl>
    </suppress>

    <!-- ================================================================
         B. FALSE POSITIVE — mxparser misidentified as XStream
         mxparser (io.github.x-stream/mxparser) is a standalone XML
         pull-parser used by XStream as an optional backend.  OWASP DC
         CPE heuristics incorrectly map it to
         cpe:2.3:a:xstream_project:xstream, causing all XStream CVEs
         to be reported against mxparser.  mxparser has no known CVEs.
         ================================================================ -->
    <suppress>
        <notes>FALSE POSITIVE: mxparser is a pull-parser library, not XStream. OWASP DC CPE misidentification via cpe:2.3:a:xstream:xstream.</notes>
        <packageUrl regex="true">^pkg:maven/io\.github\.x-stream/mxparser@.*$</packageUrl>
    </suppress>

    <!-- ================================================================
         B. FALSE POSITIVE — swagger-ui bundled DOMPurify JS
         The swagger-ui webjar bundles DOMPurify.  OWASP DC RetireJS
         scanner detects DOMPurify 3.3.2 inside the bundled JS files.
         The swagger-ui endpoint is protected behind Keycloak and is
         only accessible to authenticated operators — not exposed to
         untrusted users who could supply crafted HTML.
         ================================================================ -->
    <suppress>
        <notes>FALSE POSITIVE / LOW-RISK: DOMPurify inside swagger-ui webjar. Swagger UI endpoint is Keycloak-protected; untrusted user HTML input is not possible.</notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
    </suppress>

</suppressions>
