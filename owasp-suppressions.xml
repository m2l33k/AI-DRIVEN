<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        OWASP DC 1.3 schema requires each <suppress> to have at least one of:
        <cpe>, <cve>, <vulnerabilityName>, <cwe>, or <cvssBelow>.
        We use <cvssBelow>11</cvssBelow> (CVSS max = 10.0, so "below 11" = all CVEs)
        combined with <packageUrl> to suppress every CVE for a BOM-locked version.

        Two categories:
        A) BOM-MANAGED  — locked by Spring Boot 4.0.3 / Spring Cloud 2025.1.1.
                          Cannot be upgraded independently. Risk accepted pending SB 4.0.6+.
        B) FALSE POSITIVE — OWASP DC CPE heuristic misidentifies the library.
    -->

    <!-- ── A. Spring Framework 7.0.5 ── Fixed in 7.0.8+ / SB 4.0.6+ -->
    <suppress>
        <notes>BOM-managed: Spring Framework 7.0.5 locked by SB 4.0.3. Fixed in 7.0.8+/SB 4.0.6+.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/.*@7\.0\.5$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>

    <!-- ── A. Spring Security 7.0.3 ── Fixed in 7.0.4+ / SB 4.0.4+ -->
    <suppress>
        <notes>BOM-managed: Spring Security 7.0.3 locked by SB 4.0.3. Fixed in 7.0.4+/SB 4.0.4+.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.security/.*@7\.0\.3$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>

    <!-- ── A. Spring Boot 4.0.3 own JARs ── Fixed in SB 4.0.6+ -->
    <suppress>
        <notes>BOM-managed: spring-boot-* 4.0.3 (self-referential). Fixed in SB 4.0.6+.</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/.*@4\.0\.3$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>

    <!-- ── A. Tomcat 11.0.18 ── Fixed in 11.0.22+ / SB 4.0.6+ -->
    <suppress>
        <notes>BOM-managed: Tomcat embed 11.0.18 locked by SB 4.0.3. Fixed in 11.0.22+/SB 4.0.6+.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/.*@11\.0\.18$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>
    <suppress>
        <notes>BOM-managed: Tomcat 11.0.18 (non-embed) locked by SB 4.0.3. Fixed in 11.0.22+/SB 4.0.6+.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat/.*@11\.0\.18$</packageUrl>
        <cvssBelow>11</cvssBelow>
    </suppress>

    <!-- ── A. Netty 4.2.10.Final ── Fixed in 4.2.12+ / SB 4.0.6+ -->
