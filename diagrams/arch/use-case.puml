' ── Platform Admin ───────────────────────────────────────────
ADMIN --> UC02
ADMIN --> UC03
ADMIN --> UC35
ADMIN --> UC36
ADMIN --> UC39
ADMIN --> UC40

' ── Security Analyst ─────────────────────────────────────────
' Roaming
SA --> UC05
SA --> UC06
SA --> UC07
SA --> UC08
SA --> UC09
SA --> UC10
SA --> UC11
SA --> UC12
SA --> UC13
SA --> UC14
' Anomaly
SA --> UC15
SA --> UC16
SA --> UC17
SA --> UC18
SA --> UC19
' 5GC
SA --> UC20
SA --> UC21
SA --> UC25
' ML
SA --> UC26
SA --> UC27
SA --> UC28
' Network control
SA --> UC29
SA --> UC30
SA --> UC31
' VM
SA --> UC33
' Observability
SA --> UC39
SA --> UC40

' ── Network Operator ─────────────────────────────────────────
' 5GC management
NO --> UC20
NO --> UC21
NO --> UC22
NO --> UC23
NO --> UC24
NO --> UC25
' ML
NO --> UC26
NO --> UC27
NO --> UC28
